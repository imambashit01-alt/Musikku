{
  "name": "musikku",
  "version": "1.0.0",
  "description": "Private music player for audio files you own",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "dist": "npm run desktop:dist",
    "desktop:dev": "npm run build && electron .",
    "desktop:stage": "node scripts/stage-desktop-dependencies.mjs",
    "desktop:dist": "node scripts/desktop-dist.mjs",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "lint": "eslint client/src server/src electron client/vite.config.ts eslint.config.js",
    "format": "prettier --write client server electron eslint.config.js .prettierrc.json README.md package.json docker-compose.yml",
    "format:check": "prettier --check client server electron eslint.config.js .prettierrc.json README.md package.json docker-compose.yml"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.musikku.desktop",
    "productName": "Musikku",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "server/dist",
        "to": "server/dist"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "build/desktop-server-node-modules",
        "to": "node_modules"
      },
      {
        "from": "node_modules/node-win-x64/bin/node.exe",
        "to": "server/node.exe"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/desktop-update-config.json",
        "to": "desktop-update-config.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Musikku-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^15.14.0",
    "node-win-x64": "24.19.0",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
